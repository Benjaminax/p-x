# AI Doctor Service Environment Variables

# Backend Core API URL
BACKEND_CORE_URL=http://localhost:3001
# For Docker: http://backend-core:3001

# Brain Scan AI Service URL
AI_MODEL_ENDPOINT=http://localhost:8000
# For Docker: http://brain-scan-ai:8000

# Server Port
PORT=8001

# Logging
LOG_LEVEL=INFO

# AI Model Configuration
AI_MODEL_PATH=./models/
CONFIDENCE_THRESHOLD=0.7

# Safety Settings
ENABLE_EMERGENCY_DETECTION=true
MAX_MESSAGE_LENGTH=2000
