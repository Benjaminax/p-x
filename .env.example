# Docker Compose Environment Variables

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=securepassword

# PostgreSQL (Optional - for future features)
POSTGRES_USER=admin
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=neurohealth

# Backend
NODE_ENV=production
JWT_SECRET=change-this-to-a-very-long-random-string

# AI Services
AI_MODEL_PATH=/app/models

# Common
TZ=UTC
