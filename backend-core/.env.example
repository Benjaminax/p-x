# Backend Core Environment Variables

# Node Environment
NODE_ENV=development

# Server Port
PORT=3001

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/medical-records
# For Docker: mongodb://admin:securepassword@mongodb:27017/medical-records?authSource=admin

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-to-a-different-secure-random-string
JWT_REFRESH_EXPIRATION=7d

# Redis (for job queues)
REDIS_URL=redis://localhost:6379

# AI Services
AI_SERVICE_URL=http://localhost:8001

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=debug
